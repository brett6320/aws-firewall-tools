# --- All tools -----------------------------------------------------------------
# AWS profile to use (overridden by --profile). sg_rule_inventory, sg_access_gap and
# sg_migration_check use it only when no ARN names an account.
AWS_PROFILE=
# Default region when --region not given
AWS_REGION=us-east-1
# Base directory for auto-saved reports (<dir>/<tool>/YYYY-MM-DD/...)
FMM_REPORT_DIR=./reports

# --- Firewall Manager tools (fmm_*) --------------------------------------------
# Firewall Manager administrator (security) account id. Its local profile is found
# by account id; --profile overrides, AWS_PROFILE is the fallback.
FMM_ADMIN_ACCOUNT=
# fmm_policy_snapshot.py: where policy snapshots are saved
FMM_SNAPSHOT_DIR=./snapshots

# --- fmm_nacl_audit.py ------------------------------------------------------------
# NACL rules-per-direction limit
FMM_NACL_LIMIT=30
# Flag NACLs within this many rules of the limit
FMM_NACL_HEADROOM=3

# --- sg_quota_audit.py ------------------------------------------------------------
# Override the rules-per-security-group quota (default: Service Quotas value, else 60)
SG_RULE_LIMIT=
# Override the security-groups-per-interface quota (default: Service Quotas value, else 5)
SG_PER_ENI_LIMIT=
# Flag groups within this many rules of the limit
SG_RULE_HEADROOM=5
# Flag interfaces within this many groups of the limit
SG_ENI_HEADROOM=1

# --- prefix_list_audit.py ---------------------------------------------------------
# Flag lists within this many entries of MaxEntries
PL_HEADROOM=2
# Also flag lists at or above this utilisation percentage
PL_FULL_PCT=90
