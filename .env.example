# AWS profile to use (overridden by --profile)
AWS_PROFILE=
# Default region when --region not given
AWS_REGION=us-east-1
# Base directory for auto-saved reports (<dir>/YYYY-MM-DD/...)
FMM_REPORT_DIR=./reports
# Firewall Manager administrator (security) account id. fmm_nacl_drift.py finds
# its local profile by account id; --profile overrides, AWS_PROFILE is the fallback.
FMM_ADMIN_ACCOUNT=
# fmm_nacl_drift.py: NACL rules-per-direction limit
FMM_NACL_LIMIT=30
# fmm_nacl_drift.py: flag NACLs within this many rules of the limit
FMM_NACL_HEADROOM=3
